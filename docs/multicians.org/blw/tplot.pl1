tplot:    proc;

dcl       image(2000);

dcl       plot$plot2 entry (ptr, float bin, float bin, float bin, float bin);
dcl       plot$plot3 entry (aligned char(1), float bin, float bin);
dcl       plot$plot4 entry;
dcl       x float bin;

          call plot$plot2(addr(image),100.e0,0.e0,100.e0,0.e0);

          do x = 0.0e0 by 1.0e0 to 100.e0;
               call plot$plot3("*",x,x);
               end;

          call plot$plot4;

          end;
