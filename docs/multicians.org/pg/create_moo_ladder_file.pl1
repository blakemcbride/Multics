create_moo_ladder_file:
     procedure;

/* automatic */

dcl  code bin (15);

dcl 1 ladder,                                /* ladder declaration */
    2 key char (64) var,
    2 max fixed bin(31),
    2 num fixed bin(31),
    2 games fixed bin(31),
    2 lowavg float,
    2 lowscore fixed bin(31),
    2 lsperson char(20),
    2 message char(24),
    2 e(500) char(48);

/* files */

dcl  ladder_file file;

/* static */

dcl  alpha          char(26) int static init('ABCDEFGHIJKLMNOPQRSTUVWXYZ');

/* program */

     code = 0;

     /* Try to open the file.  */

     open file (ladder_file)
          title ('%es#m49>l>pg>hh>' || substr(alpha,6,1) ||
          substr(alpha,15,1) || substr(alpha,15,1) ||
          ' -keyis 1 64 -relative 32767')
          record sequential output keyed;

     ladder.key = 'moo_ladder';
     ladder.max = 500;
     ladder.num = 0;
     ladder.games = 0;
     ladder.lowavg = 100e0;
     ladder.lowscore = 100;
     ladder.lsperson = '';
     ladder.message = '';

     write file (ladder_file) from (ladder);

     close file (ladder_file);

     end create_ladder_file;
